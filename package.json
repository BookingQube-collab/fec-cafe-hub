{
  "name": "cafe-menu",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test": "tsx scripts/verify-menu-modifiers.ts && tsx scripts/verify-menu-language.ts && tsx scripts/verify-menu-search.ts && tsx scripts/verify-menu-discovery.ts && tsx scripts/verify-menu-refresh.ts && node scripts/verify-photo-assets.mjs && node scripts/verify-setup.mjs",
    "setup": "tsx scripts/setup.ts",
    "db:generate": "drizzle-kit generate",
    "db:configure": "node scripts/configure-supabase.mjs",
    "db:migrate": "node scripts/migrate-supabase.mjs",
    "ci:build": "node scripts/ci-build.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
