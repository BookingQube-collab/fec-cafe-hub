    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.7.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.453.0",
    "pg": "^8.23.1",
    "qr-code-styling": "^1.9.2",
