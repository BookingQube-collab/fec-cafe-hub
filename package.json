    "@types/express-session": "^1.18.0",
    "@types/node": "20.16.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "iconv-lite": "^0.7.3",
    "postcss": "^8.4.47",
    "supabase": "^2.120.0",
    "tailwindcss": "^3.4.17",
