# Copy to .env.cloud locally. Keep the filled-in copy private (never commit).
# Use a dedicated Supabase project for this café app.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_PROJECT_REF=
STORAGE_BUCKET=cafe-media
# Long random secret for Express sessions (npm run db:configure generates one).
SESSION_SECRET=
# Public URL used for permanent menu QR codes (e.g. https://menus.example.com).
# Leave unset locally so QR links use the current host (http://localhost:5100).
PUBLIC_URL=
# Optional separate staff host; defaults to PUBLIC_URL / same Node process.
# MANAGEMENT_ORIGIN=
