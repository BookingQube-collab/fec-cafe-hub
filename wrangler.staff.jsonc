{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "staff",
  "account_id": "69e2ef22efdd52ebbc1aefc3d8aa8980",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "workers_dev": true,
  "preview_urls": false,
  "placement": { "region": "aws:ap-south-1" },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "2c0378c020ab47479092cbc19fa3c95e" }],
  "minify": true,
  "alias": {
    "./db": "./server/workerDatabase.ts",
    "./passwords": "./server/workerPasswords.ts",
    "./mediaStore": "./server/workerMediaStore.ts",
    "iconv-lite": "./node_modules/iconv-lite/lib/index.js"
  },
  "vars": {
    "APPLICATION_SURFACE": "management",
    "NODE_ENV": "production",
    "CAFE_RUNTIME": "workers",
    "COOKIE_SECURE": "true",
    "TRUST_PROXY": "true",
    "TZ": "UTC",
    "STORAGE_BUCKET": "cafe-media"
  },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "triggers": { "crons": [] },
  "observability": { "enabled": true }
  // Add HYPERDRIVE binding using scripts/configure-cloud.mjs after provisioning.
  // Secrets are configured with Wrangler; never put credentials in this file.
}

