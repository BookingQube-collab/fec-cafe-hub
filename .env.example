SESSION_SECRET=replace-with-a-long-random-secret-or-run-npm-run-setup
PORT=5100
COOKIE_SECURE=false
# Set COOKIE_SECURE=true when serving through HTTPS.
# DATA_DIR=data/database
#
# Optional: run Express/Node against Supabase Postgres instead of local PGlite.
# Keep secrets in private .env.cloud (never commit). server/db.ts loads .env then
# fills missing keys from .env.cloud. When DATABASE_URL is set, media uses Supabase
# Storage if SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are also present.
# DATABASE_URL=postgresql://postgres:...@db.YOUR_REF.supabase.co:5432/postgres?sslmode=require
# Passwords use native bcrypt in Node (no Workers / cafe-passwords edge function).
